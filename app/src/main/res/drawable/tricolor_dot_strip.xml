<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="6dp" android:height="14dp" android:gravity="left">
        <shape android:shape="rectangle"><solid android:color="@color/india_saffron"/></shape>
    </item>
    <item android:width="6dp" android:height="14dp" android:gravity="center_horizontal">
        <shape android:shape="rectangle"><solid android:color="@color/india_white"/></shape>
    </item>
    <item android:width="6dp" android:height="14dp" android:gravity="right">
        <shape android:shape="rectangle"><solid android:color="@color/india_green"/></shape>
    </item>
</layer-list>
