<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/riki_bg_top"
    android:fitsSystemWindows="true">

    <!-- Address bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:elevation="3dp"
        android:background="@color/riki_surface">

        <ImageButton
            android:id="@+id/btnVpn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="@drawable/circle_icon_bg"
            android:src="@drawable/ic_shield_check"
            android:scaleType="fitCenter"
            android:contentDescription="@string/vpn_status" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/url_bar_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:textSize="14sp"
            android:textColor="@color/riki_text_primary"
            android:textColorHint="@color/riki_text_secondary"
            android:hint="@string/search_or_type_url" />

        <ImageButton
            android:id="@+id/btnTabs"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:background="@drawable/circle_icon_bg"
            android:src="@drawable/ic_tab_placeholder"
            android:scaleType="fitCenter"
            android:contentDescription="@string/tabs" />

        <TextView
            android:id="@+id/tvTabCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-14dp"
            android:layout_marginTop="-18dp"
            android:text="1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/riki_bg_top"
            android:background="@drawable/dot_active"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:background="@drawable/circle_icon_bg"
            android:src="@drawable/ic_menu"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_menu" />
    </LinearLayout>

    <!-- Tab strip (hidden until Tabs tapped) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTabs"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:visibility="gone"
        android:background="@color/riki_surface_alt"
        android:padding="4dp" />

    <!-- Find in page bar -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/riki_surface_alt"
        android:visibility="gone">

        <EditText
            android:id="@+id/etFind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/find_in_page"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textColor="@color/riki_text_primary"
            android:textColorHint="@color/riki_text_secondary" />

        <TextView
            android:id="@+id/tvFindCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/riki_text_secondary" />

        <ImageButton
            android:id="@+id/btnFindPrev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ripple_nav_item"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/btnFindNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ripple_nav_item"
            android:scaleX="-1"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/btnFindClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ripple_nav_item"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Page content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Thin divider above the bottom navigation bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1FFFFFFF" />

    <!-- Bottom navigation: Back / Forward / Home / VPN / Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:elevation="6dp"
        android:background="@color/riki_surface"
        android:weightSum="5">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="15dp"
            android:background="@drawable/ripple_nav_item"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="15dp"
            android:background="@drawable/ripple_nav_item"
            android:scaleType="fitCenter"
            android:scaleX="-1"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/forward" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="15dp"
            android:background="@drawable/ripple_nav_item"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home"
            android:contentDescription="@string/home" />

        <ImageButton
            android:id="@+id/btnBottomVpn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="15dp"
            android:background="@drawable/ripple_nav_item"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shield_check"
            android:contentDescription="@string/vpn_status" />

        <ImageButton
            android:id="@+id/btnBottomSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="15dp"
            android:background="@drawable/ripple_nav_item"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>
</LinearLayout>
