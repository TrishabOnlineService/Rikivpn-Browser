<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/server_card_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPwSite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/riki_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPwUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/riki_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPwPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/riki_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRevealPassword"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_reveal"
        android:contentDescription="@string/reveal_password" />

    <ImageButton
        android:id="@+id/btnDeletePassword"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/delete" />
</LinearLayout>
